# Database
DATABASE_URL=postgresql://docflow_user:docflow_password@db:5432/docflow_db

# JWT Auth
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=your-bucket-name

# Anthropic
ANTHROPIC_API_KEY=your-api-key

# Database (production - RDS endpoint)
DATABASE_URL=postgresql://docflow_user:password@your-rds-endpoint:5432/docflow_db